model User {
  id             String       @id @default(uuid())
  fullName       String
  email          String       @unique
  password       String
  role           Role         @default(STUDENT)

  phone          String?
  educationLevel String?
  birthDate      DateTime?
  jobStatus      String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments    Enrollment[]
  comments       Comment[]
  feedbacks      Feedback[]

  // ---- AJOUT : relation inverse requise par Prisma pour "InstructorCourses" ----
  coursesAsInstructor Course[] @relation("InstructorCourses")
  // -------------------------------------------------------------------------
}

model Course {
  id                 String       @id @default(uuid())
  slug               String       @unique
  titleAr            String
  titleEn            String
  descriptionAr      String
  descriptionEn      String
  whatYouWillLearnAr String?
  whatYouWillLearnEn String?
  imageUrl           String?
  videoUrl           String?

  // ---- FIX : "?" ajouté sur les deux lignes = professeur optionnel ----
  instructorId       String?
  instructor         User?        @relation("InstructorCourses", fields: [instructorId], references: [id])
  // ----------------------------------------------------------------

  categoryId         String?
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  published          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  chapters           Chapter[]
  enrollments        Enrollment[]
  comments           Comment[]
  offers             Offer[]
}
